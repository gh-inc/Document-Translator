# Copy to .env and fill in. NEVER commit .env (gitleaks will catch it anyway).
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

DATABASE_PATH=/data/app.db
DATA_DIR=/data

MAX_COST_PER_JOB_USD=2.00
MAX_FILE_SIZE_MB=50
MAX_PAGES=400
CHUNK_PARALLELISM=8

# openai = real provider (default) | fake = deterministic stub for dev
LLM_PROVIDER=openai
FAKE_FAIL_RATE=0.0
FAKE_LATENCY_MS=0
FAKE_FAIL_MODE=429

LOG_LEVEL=INFO

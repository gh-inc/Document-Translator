# Compose reads .env; local Python processes require exported settings.
# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

DATABASE_PATH=/data/app.db
UPLOAD_STORAGE_PATH=/data/uploads
OUTPUT_STORAGE_PATH=/data/out

# Dedicated host bind mount: this directory only, never the host filesystem.
MCP_SHARED_DIR=/mcp-files
MCP_HOST_SHARED_DIR=./mcp-files
MCP_TRIAGE_POLL_INTERVAL_SECONDS=0.1
MCP_TRIAGE_TIMEOUT_SECONDS=45

MAX_COST_PER_JOB_USD=2.00
MAX_CHUNK_CONCURRENCY=8
JOB_LEASE_SECONDS=60
CHUNK_LEASE_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=10
MAX_CHUNK_ATTEMPTS=4

# Compose defaults to fake for offline verification. Select openai for live calls.
# Application Settings default to openai when launched without Compose.
LLM_PROVIDER=fake
FAKE_FAIL_RATE=0.0
FAKE_LATENCY_MS=0
FAKE_FAIL_MODE=timeout
